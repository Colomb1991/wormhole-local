# ============================================================
# Wormhole Local — Environment Variables Template
# ============================================================
# Copia questo file in `.env.local` e compila con i valori reali.
# .env.local è gitignored, quindi non finisce mai nel repo.

# ------------------------------------------------------------
# Database (Supabase Postgres)
# ------------------------------------------------------------
# Transaction pooler (porta 6543) — usata dall'app runtime
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"

# Session pooler (porta 5432) — usata da Drizzle Kit per migrazioni
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------
# Supabase API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------
# App URLs
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_OWNER_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# ------------------------------------------------------------
# Sessioni / Auth
# ------------------------------------------------------------
# Genera con: openssl rand -base64 32
SESSION_SECRET="cambia-questo-con-una-stringa-random-lunga-almeno-32-caratteri"

# ------------------------------------------------------------
# Email (Resend) — opzionale in dev iniziale
# ------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Wormhole Local <noreply@example.com>"

# ------------------------------------------------------------
# Web Push notifications (VAPID keys)
# ------------------------------------------------------------
# Genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:founder@wormholenetwork.io"

# ------------------------------------------------------------
# Feature flags
# ------------------------------------------------------------
NEXT_PUBLIC_STRIPE_ENABLED="false"
NEXT_PUBLIC_FEEDBACK_ENABLED="true"

# ------------------------------------------------------------
# Stripe (predisposto, non attivo in v0)
# ------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""

# ------------------------------------------------------------
# Admin
# ------------------------------------------------------------
ADMIN_INITIAL_EMAIL="founder@wormholenetwork.io"

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL="info"
NODE_ENV="development"
